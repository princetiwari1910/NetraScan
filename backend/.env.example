# NetraScan Backend Configuration
ENVIRONMENT=production
PORT=8000
API_V1_STR=/api

# Security & Authentication
JWT_SECRET_KEY=replace-with-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./netrascan.db
# DATABASE_URL=postgresql://user:password@hostname:5432/netrascan

# Machine Learning & AI Triage
MODEL_PATH=ml-training/models/NetraScan_ResNet18.onnx
BLUR_THRESHOLD=35.0
REFERABLE_THRESHOLD=0.35
