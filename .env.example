# NetraScan Environment Configuration Example
# Copy this file to .env and configure for your deployment environment

# Database Configuration (PostgreSQL in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netrascan_db

# Security & JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Configuration
NETRASCAN_USE_MOCK=false
MODEL_PATH=ml-training/models/NetraScan_ResNet18.onnx
MODEL_NAME=NetraScan ResNet-18
MODEL_VERSION=1.0
REFERABLE_THRESHOLD=0.35
BLUR_THRESHOLD=35.0
ANALYSIS_TIMEOUT_SECONDS=5.0
