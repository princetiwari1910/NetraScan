# NetraScan Local Backend Configuration
ENVIRONMENT=development
PORT=8000
API_V1_STR=/api

# Security & Authentication (Local JWT)
JWT_SECRET_KEY=local-development-secret-key-netrascan-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Self-contained SQLite)
DATABASE_URL=sqlite:///./netrascan.db

# Machine Learning & AI Triage (Local ResNet-18 ONNX)
MODEL_PATH=ml-training/models/NetraScan_ResNet18.onnx
BLUR_THRESHOLD=35.0
REFERABLE_THRESHOLD=0.35
